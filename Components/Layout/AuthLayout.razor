@inherits LayoutComponentBase

<div class="grid grid-cols-[1.05fr_1fr] min-h-screen">

    @* Branding panel *@
    <aside class="bg-[#080b07] border-r border-[#2a3823] p-[2.5rem_3rem] flex flex-col justify-between gap-[2rem]">
        <a class="flex items-center gap-[.6rem] font-bold text-[1.15rem] text-[#edf2e8] tracking-[-.02em] hover:no-underline" href="/">
            <span class="text-[1.4rem]">🎱</span> CueVault
        </a>
        <div>
            <h2 class="text-[2.4rem] leading-[1.1] tracking-[-.03em] mb-[.8rem] max-w-[14ch] m-0">
                Every cue. Every table. One vault.
            </h2>
            <p class="text-[#8faa7e]">The premier billiards gear shop — cues, balls, accessories, and expert support.</p>
        </div>
        @* Decorative product list *@
        <div class="font-mono text-[.85rem] leading-none border-l-[2px] border-[#2a3823] pl-[1.1rem] grid gap-[1.1rem]" aria-hidden="true">
            <p class="m-0 flex gap-[.8rem] items-baseline text-[#8faa7e]">
                <span class="text-[#4a6a3a]">Cues</span>
                <b class="font-semibold text-[#a3d977]">Predator Revo Shaft</b>
            </p>
            <p class="m-0 flex gap-[.8rem] items-baseline text-[#8faa7e]">
                <span class="text-[#4a6a3a]">Balls</span>
                <b class="font-semibold text-[#d4a847]">Aramith Premium Set</b>
            </p>
            <p class="m-0 flex gap-[.8rem] items-baseline text-[#8faa7e]">
                <span class="text-[#4a6a3a]">Felt</span>
                <b class="font-semibold text-[#7ab8e8]">Simonis 860 Cloth</b>
            </p>
            <p class="m-0 flex gap-[.8rem] items-baseline text-[#8faa7e]">
                <span class="text-[#4a6a3a]">Tips</span>
                <b class="font-semibold text-[#c4a1ff]">Kamui Black Layered</b>
            </p>
        </div>
    </aside>

    @* Form panel *@
    <main class="grid place-items-center p-[2rem]">
        <div class="w-full max-w-[400px]">@Body</div>
    </main>
</div>

<UnderDevModal />
