@inherits LayoutComponentBase

<div class="auth-shell">
    <header class="auth-topbar">
        <a class="brand-lockup" href="/">
            <span class="brand-mark" aria-hidden="true">8</span>
            <span class="brand-name">CueVault<em>.</em></span>
        </a>
        <a class="auth-topbar-back" href="/">
            ← Back to shop
        </a>
    </header>

    <main class="auth-main">
        <div class="auth-hero">
              <img src="@StoreImages.PoolBalls"
                 alt="A group of numbered billiard balls"
                 loading="lazy" />
            <div class="auth-hero-content">
                <span class="label">Good gear. Better games.</span>
                <h2>Everything for your<br /><em>next runout.</em></h2>
                <p>Player-picked gear, shipped with care. Your table is calling — join thousands of players who trust CueVault.</p>
            </div>
        </div>

        <div class="auth-form-side">
            <div class="auth-card">
                @Body
            </div>
        </div>
    </main>

    <footer class="auth-footer-bar">
        © @DateTime.Now.Year CueVault · Play your game.
    </footer>
</div>
