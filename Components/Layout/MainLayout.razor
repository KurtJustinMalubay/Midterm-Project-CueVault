@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject CartService Cart
@inject NavigationManager Nav

<div class="store-shell">
    <div class="announcement-bar">
        <span>THE PLAYER'S SHOP</span>
        <span>Free shipping on orders over $75 <span aria-hidden="true">✦</span> Built for the love of the game</span>
        <a href="/orders">Track your order</a>
    </div>

    <header class="store-header">
        <div class="store-header-main page-container">
            <a class="brand-lockup" href="/" aria-label="CueVault home">
                <span class="brand-mark" aria-hidden="true"><span>8</span></span>
                <span class="brand-name">cuevault<span>.</span><small>THE PLAYER'S SHOP</small></span>
            </a>

            <form class="store-search" @onsubmit="Search" @onsubmit:preventDefault>
                <span class="search-icon" aria-hidden="true">⌕</span>
                <input aria-label="Search the shop" placeholder="Find your next favorite…" @bind="searchQuery" />
                <button type="submit" aria-label="Search">Search</button>
            </form>

            <div class="header-actions">
                <a class="account-action" href="@(Auth.IsAuthenticated ? "/settings" : "/login")">
                    <span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" /><path d="M5 21v-1.5a7 7 0 0 1 14 0V21z" /></svg></span>
                    <span><small>@(Auth.IsAuthenticated ? "WELCOME BACK" : "YOUR ACCOUNT")</small><b>@(Auth.Current?.Username ?? "Sign in")</b></span>
                </a>
                <a class="cart-action" href="/cart" aria-label="Shopping bag, @Cart.TotalCount items">
                    <span class="action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 8h14l1 13H4L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg></span>
                    <span class="cart-count">@Cart.TotalCount</span>
                    <span><small>YOUR BAG</small><b>$@Cart.Subtotal.ToString("0.00")</b></span>
                </a>
            </div>
        </div>

        <nav class="store-nav" aria-label="Shop navigation">
            <div class="page-container store-nav-inner">
                <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/products">Shop all</NavLink>
                <a href="/products?category=Cues">Cues</a>
                <a href="/products?category=Balls">Balls &amp; racks</a>
                <a href="/products?category=Accessories">Accessories</a>
                <NavLink href="/reviews">Customer stories</NavLink>
                <a class="nav-deals" href="/products">Shop the collection <span aria-hidden="true">→</span></a>
            </div>
        </nav>
    </header>

    <main class="store-main">
        @Body
    </main>

    <footer class="store-footer">
        <div class="page-container footer-grid">
            <div class="footer-brand">
                <a class="brand-lockup" href="/">
                    <span class="brand-mark" aria-hidden="true"><span>8</span></span>
                    <span class="brand-name">cuevault<span>.</span><small>THE PLAYER'S SHOP</small></span>
                </a>
                <p>Good gear. Better games.<br />Everything you need for your next runout.</p>
            </div>
            <div><h3>Explore</h3><a href="/products">Shop all</a><a href="/products?category=Cues">Cues</a><a href="/products?category=Balls">Balls &amp; racks</a><a href="/products?category=Accessories">Accessories</a></div>
            <div><h3>Here to help</h3><a href="/orders">Track an order</a><a href="/reviews">Customer reviews</a><a href="/settings">My account</a><a href="mailto:hello@cuevault.shop">Contact us</a></div>
            <div class="footer-note"><span class="footer-kicker">MADE FOR THE MOMENT</span><p>From the first break to the final 8-ball, we've got your table covered.</p><a href="/products">Find your gear <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="page-container footer-bottom"><span>© @DateTime.Now.Year CueVault. Play your game.</span><span>Secure checkout&nbsp; · &nbsp;Expert-picked gear&nbsp; · &nbsp;Good games guaranteed</span></div>
    </footer>
</div>

@code {
    string searchQuery = "";

    protected override void OnInitialized() => Cart.Changed += Refresh;

    void Search()
    {
        var query = Uri.EscapeDataString(searchQuery.Trim());
        Nav.NavigateTo(string.IsNullOrEmpty(query) ? "/products" : $"/products?q={query}");
    }

    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Cart.Changed -= Refresh;
}
