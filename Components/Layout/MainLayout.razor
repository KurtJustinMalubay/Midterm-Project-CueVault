@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService Auth
@inject CartService Cart
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="store-shell">
    <div class="announcement-bar">
        <span>🎱 Free shipping on orders over $75</span>
        <span>Player-picked gear, shipped with care</span>
        <a href="/orders">Track your order →</a>
    </div>

    <header class="store-header">
        <div class="page-wrap store-header-inner">
            <a class="brand-lockup" href="/" aria-label="CueVault home">
                <span class="brand-mark" aria-hidden="true">8</span>
                <span class="brand-name">
                    CueVault<em>.</em>
                    <small class="brand-sub">The Player's Shop</small>
                </span>
            </a>

            <form class="store-search" @onsubmit="Search" @onsubmit:preventDefault>
                <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" style="color:var(--muted)"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <input aria-label="Search products" placeholder="Search cues, balls, accessories…" @bind="searchQuery" />
                <button type="submit">Search</button>
            </form>

            <div class="header-actions">
                <button class="theme-toggle" type="button" @onclick="ToggleTheme"
                        aria-label="Toggle theme">
                    @if (isDark)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
                        <span>Light</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.7 13.2A8.7 8.7 0 0 1 10.8 3.3 8.8 8.8 0 1 0 20.7 13.2Z"/></svg>
                        <span>Dark</span>
                    }
                </button>

                <a class="header-btn" href="@(Auth.IsAuthenticated ? "/settings" : "/login")">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-1.5a7 7 0 0 1 14 0V21z"/></svg>
                    <span>
                        <small>@(Auth.IsAuthenticated ? "Welcome back" : "Account")</small>
                        <strong>@(Auth.Current?.Username ?? "Sign in")</strong>
                    </span>
                </a>

                <a class="header-btn @(Cart.TotalCount > 0 ? "cart-btn-active" : "")" href="/cart"
                   aria-label="Cart, @Cart.TotalCount items">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
                    @if (Cart.TotalCount > 0)
                    {
                        <span class="cart-badge">@Cart.TotalCount</span>
                    }
                    <span>
                        <small>Your bag</small>
                        <strong>$@Cart.Subtotal.ToString("0.00")</strong>
                    </span>
                </a>
            </div>
        </div>

        <nav class="store-nav" aria-label="Main navigation">
            <div class="page-wrap store-nav-inner">
                <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="/products">Shop all</NavLink>
                <a href="/products?category=Cues">Cues</a>
                <a href="/products?category=Balls">Balls & racks</a>
                <a href="/products?category=Accessories">Accessories</a>
                <NavLink href="/reviews">Reviews</NavLink>
                <NavLink href="/orders">My orders</NavLink>
                @if (Auth.IsAuthenticated)
                {
                    <NavLink href="/settings">Account</NavLink>
                }
                <a class="nav-cta" href="/products">Shop now →</a>
            </div>
        </nav>
    </header>

    <main class="store-main">
        @Body
    </main>

    <footer class="store-footer">
        <div class="page-wrap footer-grid">
            <div class="footer-brand">
                <a class="brand-lockup" href="/">
                    <span class="brand-mark" aria-hidden="true">8</span>
                    <span class="brand-name">CueVault<em>.</em></span>
                </a>
                <p>Good gear. Better games.<br />Everything you need for your next runout.</p>
            </div>
            <div>
                <h3>Shop</h3>
                <a href="/products">All products</a>
                <a href="/products?category=Cues">Cues</a>
                <a href="/products?category=Balls">Balls & racks</a>
                <a href="/products?category=Accessories">Accessories</a>
            </div>
            <div>
                <h3>Help</h3>
                <a href="/orders">Track an order</a>
                <a href="/reviews">Customer reviews</a>
                <a href="/settings">My account</a>
                <a href="mailto:hello@cuevault.shop">Contact us</a>
            </div>
            <div class="footer-note">
                <h3>Made for the moment</h3>
                <p>From the first break to the final 8-ball, we've got your game covered.</p>
                <a href="/products">Find your gear →</a>
            </div>
        </div>
        <div class="page-wrap footer-bottom">
            <span>© @DateTime.Now.Year CueVault · Play your game.</span>
            <span>Secure checkout · Expert-picked gear · Good games guaranteed</span>
        </div>
    </footer>
</div>

@code {
    string searchQuery = "";
    bool isDark = true;

    protected override void OnInitialized() => Cart.Changed += Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var theme = await JS.InvokeAsync<string>("cueVaultTheme.read");
        isDark = theme != "light";
        StateHasChanged();
    }

    async Task ToggleTheme()
    {
        isDark = !isDark;
        await JS.InvokeVoidAsync("cueVaultTheme.apply", isDark ? "dark" : "light");
    }

    void Search()
    {
        var q = Uri.EscapeDataString(searchQuery.Trim());
        Nav.NavigateTo(string.IsNullOrEmpty(q) ? "/products" : $"/products?q={q}");
    }

    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Cart.Changed -= Refresh;
}
