@page "/products"
@inject StoreService Store
@inject CartService Cart
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Shop all gear · CueVault</PageTitle>

<div class="page-wrap">
    <div class="catalog-header">
        <span class="label">Gear up for a good game</span>
        <h1>Find your <em>next favorite.</em></h1>
        <p>Player-picked essentials for every kind of table and every kind of player.</p>
    </div>

    <div class="catalog-layout">
        <!-- Sidebar -->
        <aside class="catalog-sidebar">
            <div class="sidebar-title">Categories</div>
            <div class="filter-list">
                @foreach (var cat in Categories)
                {
                    <button class="filter-btn @(activeCategory == cat ? "active" : "")"
                            @onclick="() => SetCategory(cat)">
                        <span>@cat</span>
                        <span class="filter-count">@CategoryCount(cat)</span>
                    </button>
                }
            </div>
            <div class="sidebar-help">
                <span class="label" style="font-size:10px">Need help?</span>
                <p>Not sure what's right for your game? We're players too.</p>
                <a href="mailto:hello@cuevault.shop">Ask us anything →</a>
            </div>
        </aside>

        <!-- Results -->
        <section aria-label="Products">
            <div class="catalog-toolbar">
                <div class="catalog-count">
                    <strong>@FilteredProducts.Count()</strong> products
                    @if (!string.IsNullOrWhiteSpace(q))
                    {
                        <span class="search-tag" style="margin-left:12px">
                            "@q" <button @onclick="ClearSearch" aria-label="Clear search">×</button>
                        </span>
                    }
                </div>
                <label style="display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted)">
                    Sort by
                    <select class="sort-select" @bind="sortOrder">
                        <option value="featured">Featured</option>
                        <option value="price-low">Price: low → high</option>
                        <option value="price-high">Price: high → low</option>
                    </select>
                </label>
            </div>

            @if (!FilteredProducts.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon">🔍</div>
                    <h2>No gear found.</h2>
                    <p>Try a different search or browse everything we carry.</p>
                    <button class="btn btn-primary" @onclick="ResetFilters">See all gear</button>
                </div>
            }
            else
            {
                <div class="catalog-product-grid">
                    @foreach (var product in SortedProducts)
                    {
                        <article class="product-card">
                            <div class="product-img">
                                <img src="@ProductImg(product)" alt="@product.Name" loading="lazy" />
                                @if (product.Stock <= 6)
                                {
                                    <span class="product-badge badge-low">Only @product.Stock left</span>
                                }
                                else if (product.Condition == "New")
                                {
                                    <span class="product-badge badge-new">New</span>
                                }
                                else
                                {
                                    <span class="product-badge badge-pick">Player pick</span>
                                }
                                <div class="product-add-overlay">
                                    <button class="btn btn-primary btn-sm" disabled="@(!CanAdd(product))"
                                            @onclick="() => AddToCart(product)"
                                            aria-label="Add @product.Name to bag">
                                        Add to bag
                                    </button>
                                </div>
                            </div>
                            <div class="product-body">
                                <span class="product-cat">@product.Category · @product.Condition</span>
                                <a class="product-name" href="/products">@product.Name</a>
                                <div class="product-rating">
                                    <span class="stars">★★★★★</span>
                                    <small>(@Store.GetReviewsFor(product.Id).Count())</small>
                                </div>
                                <p style="font-size:12px;color:var(--muted);margin-bottom:12px;line-height:1.5">
                                    @product.Description
                                </p>
                                <div class="product-footer">
                                    <span class="product-price">$@product.Price.ToString("0.00")</span>
                                    <button class="add-btn" disabled="@(!CanAdd(product))"
                                            aria-label="Add @product.Name to bag"
                                            @onclick="() => AddToCart(product)">+</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? q { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? category { get; set; }

    static readonly string[] Categories = ["All gear", "Cues", "Balls", "Accessories"];
    string activeCategory = "All gear";
    string sortOrder = "featured";

    string ProductImg(ProductEntry p) => StoreImages.ForProduct(p);

    IEnumerable<ProductEntry> FilteredProducts => Store.GetAllProducts().Where(p =>
        (activeCategory == "All gear" || p.Category.Equals(activeCategory, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(q) || p.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
         p.Description.Contains(q, StringComparison.OrdinalIgnoreCase) ||
         p.Tags.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase))));

    IEnumerable<ProductEntry> SortedProducts => sortOrder switch
    {
        "price-low" => FilteredProducts.OrderBy(p => p.Price),
        "price-high" => FilteredProducts.OrderByDescending(p => p.Price),
        _ => FilteredProducts.OrderByDescending(p => p.CreatedAt)
    };

    protected override void OnParametersSet()
    {
        activeCategory = Categories.FirstOrDefault(c => c.Equals(category, StringComparison.OrdinalIgnoreCase)) ?? "All gear";
    }

    int CategoryCount(string v) => v == "All gear"
        ? Store.GetAllProducts().Count()
        : Store.GetAllProducts().Count(p => p.Category.Equals(v, StringComparison.OrdinalIgnoreCase));

    void SetCategory(string v)
    {
        activeCategory = v;
        Nav.NavigateTo(v == "All gear" ? "/products" : $"/products?category={Uri.EscapeDataString(v)}");
    }
    void ClearSearch() => Nav.NavigateTo(activeCategory == "All gear" ? "/products" : $"/products?category={Uri.EscapeDataString(activeCategory)}");
    void ResetFilters() { activeCategory = "All gear"; Nav.NavigateTo("/products"); }
    bool CanAdd(ProductEntry p) => p.Stock > (Cart.Items.FirstOrDefault(i => i.ProductId == p.Id)?.Quantity ?? 0);
    void AddToCart(ProductEntry p) { if (CanAdd(p)) Cart.Add(p.Id, p.Name, p.Price); }
    protected override void OnInitialized() => Store.OnProductChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnProductChanged -= Refresh;
}
