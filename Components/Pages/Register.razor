@page "/register"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Create account · CueVault</PageTitle>

<h1>Create your account</h1>
<p>Join the CueVault community — good gear and better games await.</p>

<div class="auth-form">
    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="register">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <div class="input-group">
            <label for="rusername">Username</label>
            <InputText id="rusername" @bind-Value="model.Username" autocomplete="username"
                       placeholder="rack_master" class="auth-input" />
            <ValidationMessage For="() => model.Username" class="validation-msg" />
        </div>

        <div class="input-group">
            <label for="remail">Email</label>
            <InputText id="remail" @bind-Value="model.Email" type="email" autocomplete="email"
                       placeholder="you@cuevault.shop" class="auth-input" />
            <ValidationMessage For="() => model.Email" class="validation-msg" />
        </div>

        <div class="input-group">
            <label for="rpw">Password</label>
            <div class="input-wrap">
                <InputText id="rpw" @bind-Value="model.Password"
                           type="@(showPw ? "text" : "password")"
                           autocomplete="new-password"
                           class="auth-input auth-input-pr" />
                <button type="button" class="reveal-btn" aria-label="@(showPw ? "Hide password" : "Show password")"
                    aria-pressed="@showPw" @onclick="() => showPw = !showPw">
                    @(showPw ? "Hide" : "Show")
                </button>
            </div>
            <div class="strength-meter" aria-live="polite" aria-label="Password strength: @StrengthLabel">
                <div class="strength-bars" aria-hidden="true">
                    @for (var i = 1; i <= 4; i++)
                    {
                        var level = i;
                        <div class="strength-bar @(level <= Strength ? $"strength-{Strength}" : "")"></div>
                    }
                </div>
                <span class="strength-label">@StrengthLabel</span>
            </div>
            <ValidationMessage For="() => model.Password" class="validation-msg" />
        </div>

        <div class="input-group">
            <label for="rcpw">Confirm password</label>
            <div class="input-wrap">
                <InputText id="rcpw" @bind-Value="model.Confirm"
                           type="@(showConfirm ? "text" : "password")"
                           autocomplete="new-password"
                           class="auth-input auth-input-pr" />
                <button type="button" class="reveal-btn" aria-label="@(showConfirm ? "Hide confirmation" : "Show confirmation")"
                    aria-pressed="@showConfirm" @onclick="() => showConfirm = !showConfirm">
                    @(showConfirm ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="() => model.Confirm" class="validation-msg" />
        </div>

        <button class="btn btn-primary" style="width:100%" disabled="@busy" type="submit">
            @(busy ? "Creating account…" : "Create account")
        </button>
    </EditForm>
</div>

<p class="auth-switch">
    Already have an account? <a href="/login">Sign in</a>
</p>

@code {
    class RegisterModel
    {
        [Required(ErrorMessage = "Choose a username.")]
        [StringLength(24, MinimumLength = 3, ErrorMessage = "Use 3 to 24 characters.")]
        [RegularExpression("^[A-Za-z0-9_-]+$", ErrorMessage = "Letters, numbers, - and _ only.")]
        public string Username { get; set; } = "";
        [Required(ErrorMessage = "Enter your email.")]
        [EmailAddress(ErrorMessage = "That doesn't look like a valid email.")]
        public string Email { get; set; } = "";
        [Required(ErrorMessage = "Choose a password.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = "";
        [Required(ErrorMessage = "Confirm your password.")]
        [Compare(nameof(Password), ErrorMessage = "Passwords don't match.")]
        public string Confirm { get; set; } = "";
    }

    readonly RegisterModel model = new();
    bool busy, showPw, showConfirm;
    string? error;

    int Strength
    {
        get
        {
            var p = model.Password;
            if (p.Length == 0) return 0;
            return Math.Max(1, (p.Length >= 8 ? 1 : 0) + (p.Length >= 12 ? 1 : 0)
                + (p.Any(char.IsUpper) && p.Any(char.IsLower) ? 1 : 0)
                + (p.Any(char.IsDigit) && p.Any(c => !char.IsLetterOrDigit(c)) ? 1 : 0));
        }
    }

    string StrengthLabel => Strength switch
    {
        0 => "Use at least 8 characters",
        1 => "Weak password",
        2 => "Fair password",
        3 => "Good password",
        _ => "Strong password"
    };

    protected override void OnInitialized() { if (Auth.IsAuthenticated) Nav.NavigateTo("/"); }

    async Task SubmitAsync()
    {
        if (busy) return;
        busy = true; error = null;
        var (ok, err) = await Auth.RegisterAsync(model.Username.Trim(), model.Email.Trim(), model.Password);
        busy = false;
        if (ok) Nav.NavigateTo("/"); else error = err;
    }
}
