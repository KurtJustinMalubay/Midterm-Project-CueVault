@page "/settings"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>My account · CueVault</PageTitle>

<div class="page-wrap account-page">
    <span class="label">The player's corner</span>
    <h1>My <em>account.</em></h1>

    @if (Auth.Current is null)
    {
        <div class="account-guest">
            <div class="account-guest-img">
                <img src="@StoreImages.CueOnTable"
                     alt="A cue and cue ball on a billiards table" loading="lazy" />
            </div>
            <div class="account-guest-content">
                <span class="label">Good to have you here</span>
                <h2>Your CueVault account.</h2>
                <p>Sign in to keep your player profile up to date. You can shop and track an order without creating an account, too.</p>
                <div class="account-guest-actions">
                    <a class="btn btn-primary" href="/login">Sign in →</a>
                    <a class="btn btn-outline" href="/register">Create an account</a>
                </div>
                <p class="account-track">
                    Just tracking an order? <a href="/orders">Start here →</a>
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="account-layout">
            <aside class="account-sidebar">
                <div class="account-avatar-big">@Auth.Current.Username[..1].ToUpperInvariant()</div>
                <span class="label" style="font-size:10px">CueVault player</span>
                <h2>@Auth.Current.Username</h2>
                <p>@Auth.Current.Email</p>
                <div class="account-sidebar-links">
                    <a href="/orders">📦 Track an order</a>
                    <a href="/products">🎱 Shop gear</a>
                    <a href="/reviews">⭐ Reviews</a>
                    <button class="sign-out" @onclick="SignOut">🚪 Sign out</button>
                </div>
            </aside>

            <div class="account-panel">
                <h2>Profile information</h2>
                <p>Keep your account details current. You can check out as a guest anytime.</p>
                <EditForm Model="model" OnValidSubmit="SaveProfileAsync" FormName="settings" class="account-form">
                    <DataAnnotationsValidator />
                    @if (message is not null)
                    {
                        <div class="account-message @(isError ? "is-error" : "")" role="status">@message</div>
                    }
                    <div class="form-field">
                        <label for="susername">Username</label>
                        <InputText id="susername" @bind-Value="model.Username" autocomplete="username" class="form-input" />
                        <ValidationMessage For="() => model.Username" class="validation-msg" />
                    </div>
                    <div class="form-field">
                        <label for="semail">Email address</label>
                        <InputText id="semail" @bind-Value="model.Email" type="email" autocomplete="email" class="form-input" />
                        <ValidationMessage For="() => model.Email" class="validation-msg" />
                    </div>
                    <button class="btn btn-primary" disabled="@busy" type="submit">
                        @(busy ? "Saving…" : "Save changes")
                    </button>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    sealed class ProfileModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(24, MinimumLength = 3)]
        [RegularExpression("^[A-Za-z0-9_-]+$")]
        public string Username { get; set; } = "";
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = "";
    }

    readonly ProfileModel model = new();
    bool busy, isError;
    string? message;

    protected override void OnInitialized()
    {
        if (Auth.Current is not null) { model.Username = Auth.Current.Username; model.Email = Auth.Current.Email; }
    }

    async Task SaveProfileAsync()
    {
        if (busy) return;
        busy = true; message = null;
        var (ok, err) = await Auth.UpdateProfileAsync(model.Username.Trim(), model.Email.Trim());
        busy = false; isError = !ok; message = ok ? "Your account details are updated." : err;
    }

    void SignOut() { Auth.SignOut(); Nav.NavigateTo("/"); }
}
