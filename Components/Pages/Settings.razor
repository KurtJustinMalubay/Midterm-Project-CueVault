@page "/settings"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>My account · CueVault</PageTitle>

<div class="page-container account-page">
    <section class="account-heading"><span class="eyebrow">THE PLAYER’S CORNER</span><h1>My <em>account.</em></h1><p>Your details, your gear, your game.</p></section>

    @if (Auth.Current is null)
    {
        <section class="account-guest"><div class="account-guest-art" aria-hidden="true"><span>8</span></div><div><span class="eyebrow">GOOD TO HAVE YOU HERE</span><h2>Your CueVault account.</h2><p>Sign in to keep your player profile up to date. You can shop and track an order without creating an account, too.</p><div class="account-actions"><a class="button button-dark" href="/login">Sign in <span aria-hidden="true">→</span></a><a class="button button-outline" href="/register">Create an account</a></div><a class="account-track-link" href="/orders">Just tracking an order? Start here →</a></div></section>
    }
    else
    {
        <div class="account-layout"><aside class="account-sidebar"><div class="account-avatar">@Auth.Current.Username[..1].ToUpperInvariant()</div><span class="eyebrow">CUEVAULT PLAYER</span><h2>@Auth.Current.Username</h2><a href="/orders">Track an order →</a><button @onclick="SignOut">Sign out</button></aside><section class="account-profile"><span class="eyebrow">YOUR DETAILS</span><h2>Profile information</h2><p>Keep your account details current. You can check out as a guest anytime.</p><EditForm Model="model" OnValidSubmit="SaveProfileAsync" FormName="settings" class="account-form"><DataAnnotationsValidator />@if (message is not null) { <div class="account-message @(isError ? "is-error" : "")" role="status">@message</div> }<label><span>Username</span><InputText @bind-Value="model.Username" autocomplete="username" /></label><ValidationMessage For="() => model.Username" /><label><span>Email address</span><InputText @bind-Value="model.Email" type="email" autocomplete="email" /></label><ValidationMessage For="() => model.Email" /><button class="button button-dark" disabled="@busy">@(busy ? "Saving…" : "Save changes")</button></EditForm></section></div>
    }
</div>

@code {
    sealed class ProfileModel
    {
        [Required(ErrorMessage = "Username is required.")]
        [StringLength(24, MinimumLength = 3)]
        [RegularExpression("^[A-Za-z0-9_-]+$")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress]
        public string Email { get; set; } = "";
    }

    readonly ProfileModel model = new();
    bool busy;
    bool isError;
    string? message;

    protected override void OnInitialized()
    {
        if (Auth.Current is not null) { model.Username = Auth.Current.Username; model.Email = Auth.Current.Email; }
    }

    async Task SaveProfileAsync()
    {
        if (busy) return;
        busy = true; message = null;
        var (ok, err) = await Auth.UpdateProfileAsync(model.Username.Trim(), model.Email.Trim());
        busy = false; isError = !ok; message = ok ? "Your account details are updated." : err;
    }

    void SignOut() { Auth.SignOut(); Nav.NavigateTo("/"); }
}
