@page "/orders"
@inject StoreService Store
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Track your order · CueVault</PageTitle>

<div class="page-container track-page">
    <section class="track-intro"><span class="eyebrow">WE’LL GET YOU BACK TO THE TABLE</span><h1>Track your <em>order.</em></h1><p>Enter the email you used at checkout and we’ll find your recent CueVault orders.</p>
        <form class="track-search" @onsubmit="FindOrders" @onsubmit:preventDefault><label class="sr-only" for="order-email">Email used at checkout</label><input id="order-email" type="email" required @bind="email" placeholder="you@example.com" /><button class="button button-dark" type="submit">Find my order <span aria-hidden="true">→</span></button></form>
    </section>

    @if (hasSearched)
    {
        <section class="tracked-orders" aria-live="polite">
            @if (MatchingOrders.Any())
            {
                <div class="section-heading"><div><span class="eyebrow">GOOD NEWS, WE FOUND THEM</span><h2>Your CueVault orders</h2></div><span class="order-result-count">@MatchingOrders.Count() order(s)</span></div>
                @foreach (var order in MatchingOrders)
                {
                    <article class="tracked-order-card"><div class="tracked-order-top"><span>ORDER PLACED <b>@order.CreatedAt.ToString("MMM d, yyyy")</b></span><span class="order-status status-@order.Status.ToLowerInvariant()">@order.Status</span></div><div class="tracked-order-product"><div class="cart-item-art @ArtClass(order.ProductId)" aria-hidden="true"><span>✳</span></div><div><b>@order.ProductName</b><small>Quantity: @order.Quantity · Order #@order.Id[..8].ToUpperInvariant()</small></div><strong>$@order.Total.ToString("0.00")</strong></div><div class="order-progress"><span class="progress-step is-done"><i>✓</i> Order placed</span><span class="progress-step @(order.Status is "Shipped" or "Delivered" ? "is-done" : "")"><i>2</i> On its way</span><span class="progress-step @(order.Status == "Delivered" ? "is-done" : "")"><i>3</i> Delivered</span></div></article>
                }
            }
            else
            {
                <div class="order-not-found"><span>⌕</span><h2>No orders found for that email.</h2><p>Double-check the address from checkout, or <a href="mailto:hello@cuevault.shop">get in touch</a> and we’ll help you track it down.</p></div>
            }
        </section>
    }

    <div class="track-help"><span>✳</span><p><b>Something not quite right?</b><br />Our player support crew is happy to help. <a href="mailto:hello@cuevault.shop">Send us a note →</a></p></div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? EmailQuery { get; set; }
    string email = "";
    bool hasSearched;

    IEnumerable<OrderEntry> MatchingOrders => string.IsNullOrWhiteSpace(email) ? [] : Store.GetAllOrders().Where(order => order.CustomerEmail.Equals(email.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(EmailQuery)) { email = EmailQuery; hasSearched = true; }
    }

    void FindOrders() => hasSearched = true;
    static string ArtClass(string productId) => "art-accessory";
    protected override void OnInitialized() => Store.OnOrderChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnOrderChanged -= Refresh;
}
