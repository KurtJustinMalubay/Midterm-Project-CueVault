@page "/orders"
@inject StoreService Store
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Track your order · CueVault</PageTitle>

<div class="page-wrap orders-page">
    <span class="label">We'll get you back to the table</span>
    <h1>Track your <em>order.</em></h1>
    <p>Enter the email you used at checkout and we'll find your recent orders.</p>

    <form class="order-search-form" @onsubmit="FindOrders" @onsubmit:preventDefault>
        <label class="sr-only" for="order-email">Email used at checkout</label>
        <input id="order-email" type="email" required @bind="email"
               placeholder="you@example.com" />
        <button class="btn btn-primary" type="submit">Find my order</button>
    </form>

    @if (hasSearched)
    {
        <div aria-live="polite">
            @if (MatchingOrders.Any())
            {
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px">
                    <div>
                        <span class="label">Found them!</span>
                        <h2 style="font:600 24px/1 var(--serif);margin-top:4px">Your CueVault orders</h2>
                    </div>
                    <span style="font-size:13px;color:var(--muted)">@MatchingOrders.Count() order(s)</span>
                </div>

                @foreach (var order in MatchingOrders)
                {
                    var product = Store.GetAllProducts().FirstOrDefault(p => p.Id == order.ProductId);
                    <div class="order-card">
                        <div class="order-card-top">
                            <span>Placed on <b>@order.CreatedAt.ToString("MMM d, yyyy")</b> · Order #<b>@order.Id[..8].ToUpperInvariant()</b></span>
                            <span class="order-status status-@order.Status.ToLowerInvariant()">@order.Status</span>
                        </div>
                        <div class="order-product">
                            <div class="order-product-img">
                                <img src="@StoreImages.ForProduct(product)"
                                     alt="@order.ProductName" loading="lazy" />
                            </div>
                            <div>
                                <div class="order-product-name">@order.ProductName</div>
                                <div class="order-product-meta">Qty: @order.Quantity</div>
                            </div>
                            <div class="order-product-price">$@order.Total.ToString("0.00")</div>
                        </div>
                        <div class="order-progress">
                            <div class="progress-step done">
                                <div class="progress-dot">✓</div>
                                <span>Order placed</span>
                            </div>
                            <div class="progress-step @(order.Status is "Shipped" or "Delivered" ? "done" : "")">
                                <div class="progress-dot">@(order.Status is "Shipped" or "Delivered" ? "✓" : "2")</div>
                                <span>On its way</span>
                            </div>
                            <div class="progress-step @(order.Status == "Delivered" ? "done" : "")">
                                <div class="progress-dot">@(order.Status == "Delivered" ? "✓" : "3")</div>
                                <span>Delivered</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="order-not-found">
                    <div class="icon">🔍</div>
                    <h2>No orders found.</h2>
                    <p>Double-check the address from checkout, or <a href="mailto:hello@cuevault.shop">get in touch</a> and we'll help you track it down.</p>
                </div>
            }
        </div>
    }

    <div class="order-help">
        <span class="order-help-icon">💬</span>
        <div>
            <strong>Something not right?</strong>
            Our player support crew is happy to help.
            <a href="mailto:hello@cuevault.shop">Send us a note →</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? EmailQuery { get; set; }
    string email = "";
    bool hasSearched;

    IEnumerable<OrderEntry> MatchingOrders => string.IsNullOrWhiteSpace(email)
        ? []
        : Store.GetAllOrders().Where(o => o.CustomerEmail.Equals(email.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(EmailQuery)) { email = EmailQuery; hasSearched = true; }
    }

    void FindOrders() => hasSearched = true;
    protected override void OnInitialized() => Store.OnOrderChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnOrderChanged -= Refresh;
}
