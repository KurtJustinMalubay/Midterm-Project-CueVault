@page "/orders"
@inject StoreService Store
@implements IDisposable

<PageTitle>Orders · CueVault</PageTitle>

<div class="mb-[1.6rem]">
    <h1>Orders</h1>
    <p class="text-[#8faa7e]">Track and manage customer orders.</p>
</div>

@* Filter bar *@
<div class="bg-[#121810] border border-[#2a3823] rounded-[10px] p-[1.2rem_1.3rem]">
    <div class="flex flex-wrap gap-[.5rem] mb-[.9rem]">
        @foreach (var f in Filters)
        {
            var active = activeFilter == f;
            <button class="px-[.8rem] py-[.3rem] border rounded-full text-[.85rem] transition-colors @(active ? "border-[#a3d977] bg-[#a3d977] text-[#0d1a05] font-semibold" : "border-[#2a3823] text-[#8faa7e] hover:text-[#edf2e8] hover:border-[#3d5030]")"
                    @onclick="() => activeFilter = f">@f</button>
        }
    </div>

    @* Orders list *@
    @{
        var orders = FilteredOrders.ToList();
    }
    @if (!orders.Any())
    {
        <p class="text-[#8faa7e] text-center py-8">No orders match this filter.</p>
    }
    else
    {
        <ul class="grid gap-[2px]">
            @foreach (var o in orders)
            {
                <li class="grid grid-cols-[1fr_auto_auto_auto] gap-[1rem] items-center p-[.8rem_.5rem] rounded-[8px] hover:bg-[#1c2518]">
                    <span class="grid min-w-0">
                        <span class="font-semibold whitespace-nowrap overflow-hidden text-ellipsis">@o.CustomerName</span>
                        <span class="text-[#8faa7e] text-[.82rem]">@o.ProductName · qty @o.Quantity · @o.CreatedAt.ToString("MMM dd")</span>
                    </span>
                    <span class="text-[#d4a847] font-semibold">$@o.Total.ToString("0.00")</span>
                    <span class="@StatusClass(o.Status) font-mono text-[.82rem] font-semibold min-w-[6rem] text-right">@o.Status</span>
                    @* Status update dropdown *@
                    <select class="bg-[#1c2518] border border-[#2a3823] text-[#8faa7e] rounded-[6px] text-[.8rem] px-[.4rem] py-[.2rem] focus:outline-none focus:border-[#a3d977]"
                            value="@o.Status"
                            @onchange="e => UpdateStatus(o.Id, e.Value?.ToString() ?? o.Status)">
                        <option value="Processing">Processing</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </li>
            }
        </ul>
    }
</div>

@code {
    static readonly string[] Filters = ["All", "Processing", "Shipped", "Delivered", "Cancelled"];
    string activeFilter = "All";

    IEnumerable<OrderEntry> FilteredOrders => activeFilter == "All"
        ? Store.GetAllOrders()
        : Store.GetAllOrders().Where(o => o.Status == activeFilter);

    void UpdateStatus(string id, string status) => Store.UpdateOrderStatus(id, status);

    string StatusClass(string status) => status switch
    {
        "Delivered"  => "text-[#a3d977]",
        "Shipped"    => "text-[#7ab8e8]",
        "Processing" => "text-[#d4a847]",
        "Cancelled"  => "text-[#e07060]",
        _            => "text-[#8faa7e]"
    };

    protected override void OnInitialized() => Store.OnOrderChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnOrderChanged -= Refresh;
}
