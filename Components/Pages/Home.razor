@page "/"
@inject StoreService Store
@inject CartService Cart
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>CueVault — Gear for the love of the game</PageTitle>

<div class="home-page">

    <!-- Hero -->
    <div class="page-wrap">
        <section class="hero" style="margin-top: 32px;">
            <div class="hero-copy">
                <span class="label">For the love of the game</span>
                <h1>Make every<br />shot <em>count.</em></h1>
                <p>Thoughtfully picked cues, table essentials and upgrades that make a real difference at the table.</p>
                <div class="hero-actions">
                    <a class="btn btn-primary btn-lg" href="/products">Shop the collection</a>
                    <a class="btn btn-outline" href="/reviews">Player reviews</a>
                </div>
                <div class="hero-proof">
                    <span class="proof-stars">★★★★★</span>
                    <strong>4.8/5</strong>
                    <span>from players like you</span>
                </div>
            </div>
            <div class="hero-img">
                 <img src="@StoreImages.PoolBalls"
                     alt="Numbered pool balls ready for a game"
                     loading="eager" />
                <div class="hero-img-overlay"></div>
            </div>
        </section>

        <!-- Benefits -->
        <div class="benefits">
            <div class="benefit-item">
                <span class="benefit-icon">🎱</span>
                <div>
                    <h3>Player-picked gear</h3>
                    <p>Tested and loved at the table</p>
                </div>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">🚚</span>
                <div>
                    <h3>Free shipping $75+</h3>
                    <p>More gear, fewer extra fees</p>
                </div>
            </div>
            <div class="benefit-item">
                <span class="benefit-icon">💬</span>
                <div>
                    <h3>Real player support</h3>
                    <p>Help from people who actually play</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories -->
    <section class="section">
        <div class="page-wrap">
            <div class="section-header">
                <div>
                    <span class="label">Find your edge</span>
                    <h2>Shop by category</h2>
                </div>
                <a class="btn btn-ghost btn-sm" href="/products">See everything →</a>
            </div>
            <div class="category-grid">
                <a class="category-card" href="/products?category=Cues">
                    <img src="@StoreImages.CueOnTable"
                         alt="Billiard cues" loading="lazy" />
                    <div class="category-card-overlay">
                        <span class="label">01</span>
                        <h3>Cues</h3>
                        <span class="category-card-link">Shop cues ↗</span>
                    </div>
                </a>
                <a class="category-card" href="/products?category=Balls">
                    <img src="@StoreImages.PoolBalls"
                         alt="Billiard balls" loading="lazy" />
                    <div class="category-card-overlay">
                        <span class="label">02</span>
                        <h3>Balls & Racks</h3>
                        <span class="category-card-link">Shop balls ↗</span>
                    </div>
                </a>
                <a class="category-card" href="/products?category=Accessories">
                    <img src="@StoreImages.CueBallAndChalk"
                         alt="Billiard accessories" loading="lazy" />
                    <div class="category-card-overlay">
                        <span class="label">03</span>
                        <h3>Accessories</h3>
                        <span class="category-card-link">Shop accessories ↗</span>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- Featured products -->
    <section class="section" style="padding-top:0">
        <div class="page-wrap">
            <div class="section-header">
                <div>
                    <span class="label">Player favorites</span>
                    <h2>Good gear, great games.</h2>
                </div>
                <a class="btn btn-ghost btn-sm" href="/products">Shop all gear →</a>
            </div>
            <div class="product-grid">
                @foreach (var product in Store.GetAllProducts().Take(4))
                {
                    <article class="product-card">
                        <div class="product-img">
                            <img src="@ProductImg(product)" alt="@product.Name" loading="lazy" />
                            @if (product.Stock <= 6)
                            {
                                <span class="product-badge badge-low">Only @product.Stock left</span>
                            }
                            else
                            {
                                <span class="product-badge badge-pick">Player pick</span>
                            }
                            <div class="product-add-overlay">
                                <button class="btn btn-primary" disabled="@(!CanAdd(product))"
                                        @onclick="() => AddToCart(product)"
                                        aria-label="Add @product.Name to bag">
                                    Add to bag
                                </button>
                            </div>
                        </div>
                        <div class="product-body">
                            <span class="product-cat">@product.Category</span>
                            <a class="product-name" href="/products">@product.Name</a>
                            <div class="product-rating">
                                <span class="stars">★★★★★</span>
                                <small>(@Store.GetReviewsFor(product.Id).Count() reviews)</small>
                            </div>
                            <div class="product-footer">
                                <span class="product-price">$@product.Price.ToString("0.00")</span>
                                <button class="add-btn" disabled="@(!CanAdd(product))"
                                        aria-label="Add @product.Name to bag"
                                        @onclick="() => AddToCart(product)">+</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- Story banner -->
    <div class="page-wrap" style="padding-bottom:64px">
        <div class="story-banner">
            <div class="story-img">
                <img src="@StoreImages.CueOnTable"
                     alt="Pool hall atmosphere" loading="lazy" />
            </div>
            <div class="story-copy">
                <span class="label">More than just gear</span>
                <h2>It's not just the shot.<br /><em>It's the feeling.</em></h2>
                <p>The quiet before the break. The click of a clean hit. That one table you always come back to. We're here for all of it.</p>
                <a class="btn btn-primary" href="/reviews">Hear it from the players →</a>
            </div>
        </div>
    </div>

    <!-- Reviews -->
    <section class="section" style="padding-top:0">
        <div class="page-wrap">
            <div class="section-header">
                <div>
                    <span class="label">Don't just take our word for it</span>
                    <h2>Good words from good players.</h2>
                </div>
                <a class="btn btn-ghost btn-sm" href="/reviews">All reviews →</a>
            </div>
            <div class="reviews-grid">
                @foreach (var review in Store.GetAllReviews().Take(3))
                {
                    <article class="review-card">
                        <div class="review-stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</div>
                        <blockquote>"@review.Comment"</blockquote>
                        <div class="review-byline">
                            <span class="review-avatar">@review.Author[..1]</span>
                            <span>
                                <b>@review.Author</b>
                                <small>Verified player · @review.ProductName</small>
                            </span>
                            <span class="review-check">✓</span>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

@code {
    string ProductImg(ProductEntry p) => StoreImages.ForProduct(p);

    protected override void OnInitialized() => Store.OnProductChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    bool CanAdd(ProductEntry product) => product.Stock > (Cart.Items.FirstOrDefault(i => i.ProductId == product.Id)?.Quantity ?? 0);
    void AddToCart(ProductEntry product) { if (CanAdd(product)) Cart.Add(product.Id, product.Name, product.Price); }
    public void Dispose() => Store.OnProductChanged -= Refresh;
}
