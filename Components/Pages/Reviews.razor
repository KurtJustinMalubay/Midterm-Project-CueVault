@page "/reviews"
@inject StoreService Store
@implements IDisposable

<PageTitle>Player stories · CueVault</PageTitle>

<div class="page-container reviews-page">
    <section class="reviews-hero"><span class="eyebrow">GOOD WORDS FROM GOOD PLAYERS</span><h1>Real players.<br /><em>Real good games.</em></h1><p>We’re here for the love of the game. Turns out, so are the people who shop with us.</p><div class="reviews-score"><b>@Store.AverageRating.ToString("0.0")</b><span><span class="review-stars">★★★★★</span><small>Based on @Store.GetAllReviews().Count() player reviews</small></span></div></section>

    <section class="review-list-section"><div class="section-heading"><div><span class="eyebrow">PLAYER NOTES</span><h2>A few words from the table.</h2></div><a class="text-link" href="/products">Find your gear <span aria-hidden="true">→</span></a></div>
        @if (Store.GetAllReviews().Any())
        {
            <div class="review-grid review-grid-large">
                @foreach (var review in Store.GetAllReviews())
                {
                    <article class="review-card"><div class="review-stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</div><blockquote>“@review.Comment”</blockquote><div class="review-byline"><span class="review-avatar">@review.Author[..1]</span><span><b>@review.Author</b><small>Verified player · @review.ProductName</small></span><span class="verified-mark">✓</span></div></article>
                }
            </div>
        }
        else
        {
            <p class="empty-reviews">Player stories will be right here soon. In the meantime, take a look around the shop.</p>
        }
    </section>
    <section class="review-cta"><span class="eyebrow">YOUR NEXT FAVORITE IS WAITING</span><h2>Ready to make your game<br />feel a little more like <em>yours?</em></h2><a class="button button-light" href="/products">Shop player-picked gear <span aria-hidden="true">→</span></a></section>
</div>

@code {
    protected override void OnInitialized() => Store.OnReviewChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnReviewChanged -= Refresh;
}
