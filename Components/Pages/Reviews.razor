@page "/reviews"
@inject StoreService Store
@implements IDisposable

<PageTitle>Player stories · CueVault</PageTitle>

<div class="reviews-page">
    <div class="page-wrap">
        <div class="reviews-hero">
            <span class="label">Good words from good players</span>
            <h1>Real players.<br /><em>Real good games.</em></h1>
            <p>We're here for the love of the game. Turns out, so are the people who shop with us.</p>
            <div class="reviews-score">
                <span class="score-num">@Store.AverageRating.ToString("0.0")</span>
                <div>
                    <div class="score-stars">★★★★★</div>
                    <small>Based on @Store.GetAllReviews().Count() reviews</small>
                </div>
            </div>
        </div>

        <div style="margin-bottom:24px;display:flex;align-items:flex-end;justify-content:space-between">
            <div>
                <span class="label">Player notes</span>
                <h2 style="font:600 28px/1.1 var(--serif);letter-spacing:-.02em;margin-top:8px">A few words from the table.</h2>
            </div>
            <a class="btn btn-ghost btn-sm" href="/products">Find your gear →</a>
        </div>

        @if (Store.GetAllReviews().Any())
        {
            <div class="reviews-grid-large">
                @foreach (var review in Store.GetAllReviews())
                {
                    <article class="review-card">
                        <div class="review-stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</div>
                        <blockquote>"@review.Comment"</blockquote>
                        <div class="review-byline">
                            <span class="review-avatar">@review.Author[..1]</span>
                            <span>
                                <b>@review.Author</b>
                                <small>Verified player · @review.ProductName</small>
                            </span>
                            <span class="review-check">✓</span>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p style="color:var(--muted);padding:40px 0">Player stories will appear here soon. <a href="/products">Take a look around the shop.</a></p>
        }

        <div class="reviews-cta">
            <span class="label">Your next favorite is waiting</span>
            <h2>Ready to make your game<br />feel a little more like <em>yours?</em></h2>
            <a class="btn btn-primary btn-lg" href="/products">Shop player-picked gear →</a>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Store.OnReviewChanged += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.OnReviewChanged -= Refresh;
}
