@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject UiState Ui

<PageTitle>Sign in · CueVault</PageTitle>

<h1>Welcome back</h1>
<p>Sign in to your CueVault player account.</p>

<div class="auth-form">
    <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="login">
        <DataAnnotationsValidator />

        @if (error is not null)
        {
            <div class="auth-error" role="alert">@error</div>
        }

        <div class="input-group">
            <label for="lid">Username or email</label>
            <InputText id="lid" @bind-Value="model.Id" autocomplete="username"
                       placeholder="you@cuevault.shop" class="auth-input" />
            <ValidationMessage For="() => model.Id" class="validation-msg" />
        </div>

        <div class="input-group">
            <div class="input-label-row">
                <label for="lpw">Password</label>
                <button type="button" class="forgot-link" @onclick='() => Ui.Show("Password reset")'>
                    Forgot password?
                </button>
            </div>
            <div class="input-wrap">
                <InputText id="lpw" @bind-Value="model.Password"
                           type="@(showPw ? "text" : "password")"
                           autocomplete="current-password"
                           class="auth-input auth-input-pr" />
                <button type="button" class="reveal-btn" aria-label="@(showPw ? "Hide password" : "Show password")"
                    aria-pressed="@showPw" @onclick="() => showPw = !showPw">
                    @(showPw ? "Hide" : "Show")
                </button>
            </div>
            <ValidationMessage For="() => model.Password" class="validation-msg" />
        </div>

        <button class="btn btn-primary" style="width:100%" disabled="@busy" type="submit">
            @(busy ? "Signing in…" : "Sign in")
        </button>
    </EditForm>
</div>

<p class="auth-switch">
    New to CueVault? <a href="/register">Create an account</a>
</p>

@code {
    class LoginModel
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        public string Id { get; set; } = "";
        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }

    readonly LoginModel model = new();
    bool busy, showPw;
    string? error;

    protected override void OnInitialized() { if (Auth.IsAuthenticated) Nav.NavigateTo("/"); }

    async Task SubmitAsync()
    {
        if (busy) return;
        busy = true; error = null;
        var (ok, err) = await Auth.LoginAsync(model.Id.Trim(), model.Password);
        busy = false;
        if (ok) Nav.NavigateTo("/"); else error = err;
    }
}
