@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav
@inject UiState Ui

<PageTitle>Sign in · CueVault</PageTitle>
<h1 class="text-[1.75rem] leading-[1.2] m-0 mb-[.4rem] tracking-[-.02em]">Welcome back</h1>
<p class="m-0 mb-[1rem] text-[#8faa7e]">Sign in to manage your CueVault store.</p>

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="login" class="grid gap-[1.1rem] mt-[1.6rem]">
    <DataAnnotationsValidator />

    @if (error is not null)
    {
        <div class="bg-[#e07060]/10 border border-[#e07060]/40 text-[#f0b0a0] px-[.9rem] py-[.7rem] rounded-[10px] text-[.9rem]" role="alert">
            @error
        </div>
    }

    <label class="grid gap-[.4rem] font-semibold text-[.9rem]">
        <span>Username or email</span>
        <InputText @bind-Value="model.Id" autocomplete="username" placeholder="you@cuevault.shop"
                   class="@InputCss" />
        <ValidationMessage For="() => model.Id" class="text-[#e07060] font-normal text-[.82rem]" />
    </label>

    <div class="grid gap-[.4rem] font-semibold text-[.9rem]">
        <div class="flex justify-between items-baseline">
            <label for="pw">Password</label>
            <button type="button" class="text-[#a3d977] text-[.875rem] hover:underline"
                    @onclick='() => Ui.Show("Password reset")'>Forgot password?</button>
        </div>
        <span class="relative block">
            <InputText id="pw" @bind-Value="model.Password"
                       type="@(showPw ? "text" : "password")"
                       autocomplete="current-password"
                       class="@($"{InputCss} w-full pr-[4.2rem]")" />
            <button type="button"
                    class="text-[#a3d977] text-[.875rem] hover:underline absolute right-[.8rem] top-1/2 -translate-y-1/2"
                    @onclick="() => showPw = !showPw">
                @(showPw ? "Hide" : "Show")
            </button>
        </span>
        <ValidationMessage For="() => model.Password" class="text-[#e07060] font-normal text-[.82rem]" />
    </div>

    <button class="@BtnPrimary w-full" disabled="@busy">
        @(busy ? "Signing in…" : "Sign in")
    </button>
</EditForm>

<p class="text-center m-0 mt-[1.5rem] text-[#8faa7e]">
    New to CueVault? <a href="/register" class="text-[#a3d977] no-underline hover:underline">Create an account</a>
</p>

@code {
    class LoginModel
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        public string Id { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }

    readonly LoginModel model = new();
    bool busy, showPw;
    string? error;

    const string InputCss = "w-full px-[.85rem] py-[.7rem] bg-[#121810] border border-[#2a3823] rounded-[10px] text-[#edf2e8] font-normal placeholder-[#4a6a3a] focus:outline-none focus:border-[#a3d977] focus:shadow-[0_0_0_3px_rgba(163,217,119,.18)]";
    const string BtnPrimary = "inline-flex items-center justify-center gap-[.4rem] px-[1.05rem] py-[.6rem] rounded-[10px] font-semibold border border-transparent transition-[filter,background] duration-150 bg-[#a3d977] text-[#0d1a05] hover:brightness-[1.08] hover:no-underline disabled:opacity-50 disabled:cursor-not-allowed";

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated) Nav.NavigateTo("/");
    }

    async Task SubmitAsync()
    {
        if (busy) return;
        busy = true; error = null;
        var (ok, err) = await Auth.LoginAsync(model.Id.Trim(), model.Password);
        busy = false;
        if (ok) Nav.NavigateTo("/"); else error = err;
    }
}
