@inject UiState Ui
@implements IDisposable

@if (Ui.Feature is not null && Ui.Feature != "Add product" && Ui.Feature != "Search")
{
    <div class="modal-backdrop" @onclick="Ui.Close">
        <div class="modal-card" style="max-width:380px;text-align:center"
             role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div style="font-size:48px;margin-bottom:12px">🚧</div>
            <h2 style="font:600 20px/1.1 var(--serif);margin-bottom:8px">@Ui.Feature is coming soon</h2>
            <p style="color:var(--muted);font-size:14px;margin-bottom:20px">We're still building this part of CueVault. It'll be here soon.</p>
            <button class="btn btn-primary" @onclick="Ui.Close">Got it</button>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Ui.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Ui.Changed -= Refresh;
}
