@inject UiState Ui
@inject StoreService Store
@implements IDisposable

@if (Ui.Feature == "Add product")
{
    <div class="modal-backdrop" @onclick="Ui.Close">
        <div class="modal-card" role="dialog" aria-modal="true" aria-label="Add new product"
             @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Add new product</h2>
                <button class="modal-close" @onclick="Ui.Close" aria-label="Close">×</button>
            </div>

            <div class="modal-grid">
                <div class="form-field">
                    <label>Product name</label>
                    <input @bind="name" class="modal-input" placeholder="e.g. Predator Revo Shaft" />
                </div>

                <div class="form-field">
                    <label>Description</label>
                    <textarea @bind="description" rows="2" class="modal-input" style="resize:vertical"></textarea>
                </div>

                <div class="modal-row">
                    <div class="form-field">
                        <label>Category</label>
                        <select @bind="category" class="modal-input">
                            <option value="Cues">Cues</option>
                            <option value="Balls">Balls</option>
                            <option value="Accessories">Accessories</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label>Condition</label>
                        <select @bind="condition" class="modal-input">
                            <option value="New">New</option>
                            <option value="Used">Used</option>
                        </select>
                    </div>
                </div>

                <div class="modal-row">
                    <div class="form-field">
                        <label>Price ($)</label>
                        <input type="number" @bind="price" min="0" step="0.01" class="modal-input" />
                    </div>
                    <div class="form-field">
                        <label>Stock</label>
                        <input type="number" @bind="stock" min="0" class="modal-input" />
                    </div>
                </div>

                <div class="form-field">
                    <label>Tags <span style="font-weight:400;color:var(--muted)">(space-separated)</span></label>
                    <input @bind="tagsRaw" class="modal-input" placeholder="cue shaft predator" />
                </div>

                @if (error is not null)
                {
                    <p style="color:var(--danger);font-size:13px">@error</p>
                }

                <div class="modal-footer">
                    <button class="btn btn-ghost btn-sm" @onclick="Ui.Close">Cancel</button>
                    <button class="btn btn-primary btn-sm" disabled="@string.IsNullOrWhiteSpace(name)"
                            @onclick="Save">Add product</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    string name = "", description = "", tagsRaw = "";
    string category = "Cues", condition = "New";
    decimal price;
    int stock;
    string? error;

    protected override void OnInitialized() => Ui.Changed += Refresh;

    void Refresh()
    {
        if (Ui.Feature == "Add product")
        { name = description = tagsRaw = ""; category = "Cues"; condition = "New"; price = 0; stock = 0; error = null; }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Ui.Changed -= Refresh;

    void Save()
    {
        if (string.IsNullOrWhiteSpace(name)) { error = "Product name is required."; return; }
        var tags = tagsRaw.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        Store.AddProduct(name.Trim(), description.Trim(), category, price, stock, condition, tags);
        Ui.Close();
    }
}
