@inject UiState Ui
@inject StoreService Store
@inject NavigationManager Nav
@implements IDisposable

@if (Ui.Feature == "Search")
{
    <div class="fixed inset-0 bg-[#040802]/80 backdrop-blur-sm grid place-items-start pt-[10vh] px-4 z-50"
         @onclick="Ui.Close">
        <div class="w-full max-w-[640px] bg-[#121810] border border-[#2a3823] rounded-[14px] shadow-[0_24px_60px_rgba(0,0,0,.6)] overflow-hidden"
             role="dialog" aria-modal="true"
             @onclick:stopPropagation>

            <div class="flex items-center px-4 py-3 border-b border-[#2a3823]">
                <span class="text-[#8faa7e] text-lg mr-3">🔍</span>
                <input @bind="query" @bind:event="oninput" type="text"
                       class="flex-1 bg-transparent border-none text-[#edf2e8] text-[1.1rem] focus:outline-none focus:ring-0"
                       placeholder="Search products, categories, tags…"
                       autofocus />
                <kbd class="font-mono text-[.75rem] p-[.15rem_.45rem] border border-[#2a3823] rounded-[5px] text-[#8faa7e] ml-3 cursor-pointer"
                     @onclick="Ui.Close">ESC</kbd>
            </div>

            @if (Results.Any())
            {
                <ul class="max-h-[60vh] overflow-y-auto p-2">
                    @foreach (var p in Results)
                    {
                        <li>
                            <button class="grid grid-cols-[auto_1fr_auto] gap-[.9rem] items-center w-full text-left p-[.7rem_.8rem] rounded-[8px] hover:bg-[#1c2518]"
                                    @onclick="() => GoToProducts()">
                                <span class="text-[#a3d977] font-mono text-[.8rem] font-semibold min-w-[5rem]">@p.Category</span>
                                <span class="grid min-w-0">
                                    <span class="font-semibold whitespace-nowrap overflow-hidden text-ellipsis text-[#edf2e8]">@p.Name</span>
                                    <span class="text-[.82rem] text-[#8faa7e]">$@p.Price.ToString("0.00") · Stock: @p.Stock</span>
                                </span>
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <div class="p-8 text-center text-[#8faa7e]">
                    <p>No products found for "@query"</p>
                </div>
            }
        </div>
    </div>
}

@code {
    string query = "";

    IEnumerable<ProductEntry> Results => string.IsNullOrWhiteSpace(query)
        ? []
        : Store.GetAllProducts().Where(p =>
            p.Name.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            p.Category.Contains(query, StringComparison.OrdinalIgnoreCase) ||
            p.Tags.Any(t => t.Contains(query, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized() => Ui.Changed += Refresh;

    void Refresh()
    {
        if (Ui.Feature == "Search") query = "";
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Ui.Changed -= Refresh;

    void GoToProducts()
    {
        Ui.Close();
        Nav.NavigateTo("/products");
    }
}
